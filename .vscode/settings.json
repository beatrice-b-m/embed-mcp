{
  "yaml.schemas": {
    // Generated by `embed-context check`. The second pattern covers checkouts
    // under a dot-directory such as .claude/worktrees/, because `**` in the
    // YAML extension's globs does not descend into dot-directories.
    "./.embed-context/schema.json": [
      "catalog/**/*.yaml",
      "**/.claude/worktrees/*/catalog/**/*.yaml"
    ]
  },
  "yaml.completion": true,
  "yaml.hover": true,
  "yaml.validate": true
}
