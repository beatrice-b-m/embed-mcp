{#- Code lookup (embed_context.query.lookup_code). A column's code-list
    results each name the mapping they come from, since a column may use a
    different code list under each mapping's qualifiers. -#}
{% import "text/_macros.j2" as m with context %}
{%- macro mapping(c) -%}
{% if c.mapping is defined %}

  under the mapping to {{ ref(c.mapping.feature) }}{% if c.mapping.feature_label is defined %} — {{ c.mapping.feature_label }}{% endif %}
{%- if c.mapping.qualifiers is defined %}{% for name, value in c.mapping.qualifiers.items() %}{% if value is sameas true %} · {{ name }}{% elif value is string %} · {{ name | replace("_", " ") }} {{ value }}{% elif value is not sameas false %} · {{ name | replace("_", " ") }}: {{ value | join("; ") }}{% endif %}{% endfor %}{% endif %}
{%- endif %}
{%- endmacro -%}
{%- macro entry(e) -%}
{% if e.represented_values is defined %}

  represented values: {% for v in e.represented_values %}"{{ v }}"{{ ", " if not loop.last }}{% endfor %}
{%- endif %}
{% if e.caveats is defined %}
{% for c in e.caveats %}

  caveat: {{ c }}
{%- endfor %}
{% endif %}
{% for c in e.mappings | default([]) %}{{ mapping({"mapping": c}) }}{% endfor %}
{%- endmacro -%}
{{ d.value }} in {{ d.address }}
{% set meanings = d.codes | rejectattr("match", "equalto", "none") | list %}
{% if meanings | length > 1 %}
{{ d.value }} has a meaning in {{ meanings | length }} code lists; each applies only under its own mapping.
{% endif %}
{% for c in d.codes %}
{% if c.meaning is not none %}
- {{ c.meaning }} — {{ ref(c.vocabulary) }} ({{ c.vocabulary_label }}){% if c.column %}, column {{ ref(c.column) }}{% endif %}{{ mapping(c) }}
{% elif c.match == "tokens" %}
- Not a single code of {{ ref(c.vocabulary) }} ({{ c.vocabulary_label }}){% if c.column %}, column {{ ref(c.column) }}{% endif %}; parsing {{ c.parsing }}, so each part between "{{ c.delimiter }}" is looked up:
{%- for t in c.tokens %}

    {{ t.code }}: {% if t.meaning is not none %}{{ t.meaning }}{% else %}not in this code list{% if t.similar_codes is defined %}; differs only in case or spacing from: {{ t.similar_codes | join(", ") }}{% endif %}{% endif %}
{%- endfor %}
{{ mapping(c) }}
{% else %}
- Not in {{ ref(c.vocabulary) }} ({{ c.vocabulary_label }}){% if c.column %}, column {{ ref(c.column) }}{% endif %}{% if c.parsing is defined %}; parsing {{ c.parsing }}{% endif %}{% if c.similar_codes %}; differs only in case or spacing from: {{ c.similar_codes | join(", ") }}{% endif %}{{ mapping(c) }}
{% endif %}
{% endfor %}
{% for i in d.interpretations %}
- Column interpretation{% if i.status is defined %} ({{ i.status }}){% endif %}{% if i.match == "listed" %} of "{{ i.representation }}", which lists {{ d.value }}{% endif %}: {{ i.meaning }} — {{ ref(i.id) }}{{ entry(i) }}
{% endfor %}
{% for s in d.missing_states %}
- Missing state{% if s.match == "listed" %} "{{ s.representation }}", which lists {{ d.value }}{% endif %}: {{ s.meaning }} — {{ ref(s.id) }}{{ entry(s) }}
{% endfor %}
{% if not d.codes and not d.interpretations and not d.missing_states %}
No code list, interpretation, or missing state names {{ d.value }}.
{% endif %}
{% if d.other_interpretations is defined %}

Other interpretations of {{ "the column" if d.other_interpretations | map(attribute="column") | unique | list | length == 1 else "the columns" }}, which do not name {{ d.value }}; one whose representation describes values without listing them may still cover it:
{% for i in d.other_interpretations %}
- "{{ i.representation }}"{% if i.status is defined %} ({{ i.status }}){% endif %}: {{ i.meaning }} — {{ ref(i.id) }}{{ entry(i) }}
{% endfor %}
{% endif %}
{{ m.legend(d) }}
