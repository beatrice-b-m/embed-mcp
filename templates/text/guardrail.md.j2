{#- Guardrails lead with their statement, then its priority and category. -#}
{% extends "text/_default.md.j2" %}
{% block body %}
{% for f in d.fields if f.name == "statement" %}

{{ f.text }}
{% endfor %}

{{ m.fields(d.fields | selectattr("name", "equalto", "priority") | list) }}
{{- m.fields(d.fields | selectattr("name", "equalto", "category") | list) }}
{{- m.fields(d.fields | rejectattr("name", "in", ["statement", "priority", "category"]) | list) }}
{%- endblock %}
